---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Fastty — GPU-accelerated terminal emulator in Rust",
  description = "Fastty is a modern, GPU-accelerated terminal emulator built with Rust and GPUI. Pixel-perfect paint grid, seamless TUI block synthesis, command palette, project jumper, and in-buffer search.",
} = Astro.props;

const site = "https://fastyterm.vercel.app";
const canonical = `${site}${Astro.url.pathname}`;
const ogImage = `${site}/og-image.png`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0e0e0e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" sizes="any" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Fastty — a terminal that runs at idle" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <slot />
    <script>
      import { initReveal } from "../lib/reveal";
      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initReveal, { once: true });
      } else {
        initReveal();
      }
    </script>
  </body>
</html>

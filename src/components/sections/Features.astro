---
import { fetchRepo, stripVersionPrefix } from "../../lib/repo";

const { version } = await fetchRepo();
const numericVersion = stripVersionPrefix(version);

const features = [
  {
    eyebrow: "01",
    title: "Low-level Paint API & Pixel-Perfect Grid",
    body: "Direct GPU hardware quad rendering with per-cell advance control. Box-drawing characters and block elements are synthesized at exact pixel boundaries with zero hairline gaps for seamless TUI banners and logos.",
    visual: "wgsl",
  },
  {
    eyebrow: "02",
    title: "Sub-1% CPU at idle & Synchronized Output",
    body: "The event loop rests when inactive. DEC mode 2026 synchronized output guarantees zero tearing or flicker during intensive CLI and TUI rendering.",
    visual: "idle",
  },
  {
    eyebrow: "03",
    title: "Command Palette & Project Jumper",
    body: "Fuzzy-search any action via ⌘⇧P or jump between tabs, git worktrees, and projects with ⌘J. Live git branch indicators and high-contrast navigation keep you in the flow.",
    visual: "tabs",
  },
  {
    eyebrow: "04",
    title: "Smart Token Detection & In-Buffer Search",
    body: "Automatic classifier underlines clickable URLs, local file paths, and hex colors. Built-in buffer search (⌘F) provides instantaneous match navigation and scrollback jumping.",
    visual: "bottombar",
  },
];
---

<section class="section features" id="features">
  <div class="container">
    <header class="features-intro">
      <span class="section-num mono">[03 / 04]</span>
      <h2 class="features-title">
        Six primitives, one<br />
        quiet terminal.
      </h2>
      <p class="features-lead">
        Fastty is small on purpose. No plugin runtime, no daemon, no telemetry.
        The whole binary is one Rust crate plus the bits you can see in
        <span class="inline-mono">src/</span>. Every feature earned its keep.
      </p>
    </header>

    <div class="features-list">
      {features.map((f, i) => (
        <article class="feature-row" data-side={i % 2 === 0 ? "left" : "right"} data-reveal data-reveal-index={i}>
          <div class="feature-text">
            <span class="feature-num mono">{f.eyebrow}</span>
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-body">{f.body}</p>
          </div>

          <div class="feature-visual">
            {f.visual === "wgsl" && (
              <div class="visual-cell">
                <div class="vc-bar mono">
                  <div class="vc-dots" aria-hidden="true"><span></span><span></span><span></span></div>
                  <span class="vc-tab">~/projects/fastty</span>
                  <span class="vc-tag">paint api renderer</span>
                </div>
                <div class="vc-screen mono" data-terminal>
                  <div class="vc-line" data-line="1">
                    <span class="vc-sigil">❯</span>
                    <span class="vc-cmd" data-typed="ls --color=always"></span>
                    <span class="vc-cursor" data-cursor="1" aria-hidden="true"></span>
                  </div>
                  <div class="vc-output" data-output="1">
                    <div class="vc-out">
                      <span class="vc-out-dir">.</span>
                      <span class="vc-out-dim">..</span>
                      <span class="vc-out-file">README.md</span>
                      <span class="vc-out-file">Cargo.toml</span>
                      <span class="vc-out-exec">target/</span>
                    </div>
                    <div class="vc-out vc-glyphs">─ │ ┌ ┐ └ ┘ ├ ┤ ┬ ┴ ┼ ░ ▒ ▓ █</div>
                    <div class="vc-out vc-glyphs">← → ↑ ↓ ⇄ ★ ◆ ⚡ ✓ ✗ · α β γ δ · 你好</div>
                  </div>
                  <div class="vc-line vc-active" data-line="2">
                    <span class="vc-sigil">❯</span>
                    <span class="vc-cursor" data-cursor="2" aria-hidden="true"></span>
                  </div>
                </div>
                <div class="vc-foot mono">
                  <span class="vc-foot-label">gpui</span>
                  <span class="vc-foot-backends">metal · vulkan · directx · wayland · x11</span>
                </div>
              </div>
            )}

            {f.visual === "idle" && (
              <div class="visual-idle">
                <div class="vi-bar mono">
                  <div class="vi-dots" aria-hidden="true"><span></span><span></span><span></span></div>
                  <span class="vi-tab">~/projects/fastty</span>
                  <span class="vi-tag">idle · 02:14:08</span>
                </div>
                <div class="vi-screen mono" data-terminal>
                  <div class="vi-line" data-line="1">
                    <span class="vi-sigil">❯</span>
                    <span class="vi-cmd" data-typed="cargo build --release"></span>
                    <span class="vi-cursor" data-cursor="1" aria-hidden="true"></span>
                  </div>
                  <div class="vi-output" data-output="1">
                    <div class="vi-out vi-dim">    Compiling fastty {numericVersion} (38 crates)</div>
                    <div class="vi-out vi-dim">    Finished `release` in 4.21s</div>
                  </div>
                  <div class="vi-line vi-active" data-line="2">
                    <span class="vi-sigil">❯</span>
                    <span class="vi-cursor" data-cursor="2" aria-hidden="true"></span>
                  </div>
                </div>
                <div class="vi-foot mono">
                  <div class="vi-stat">
                    <span class="vi-stat-key">cpu</span>
                    <span class="vi-stat-bar"><i style="--w: 1%"></i></span>
                    <span class="vi-stat-val">0.7%</span>
                  </div>
                  <div class="vi-stat">
                    <span class="vi-stat-key">rss</span>
                    <span class="vi-stat-bar"><i style="--w: 18%"></i></span>
                    <span class="vi-stat-val">52 mb</span>
                  </div>
                  <div class="vi-stat">
                    <span class="vi-stat-key">wakeups</span>
                    <span class="vi-stat-bar"><i style="--w: 0%"></i></span>
                    <span class="vi-stat-val">0.0/s</span>
                  </div>
                  <div class="vi-stat">
                    <span class="vi-stat-key">energy</span>
                    <span class="vi-stat-bar"><i style="--w: 4%"></i></span>
                    <span class="vi-stat-val">12 mj</span>
                  </div>
                </div>
              </div>
            )}

            {f.visual === "tabs" && (
              <div class="tear-stage" aria-hidden="true">
                <div class="tear-window tear-window-1">
                  <div class="tear-tabs">
                    <span class="tear-tab tear-tab-active">~/projects/fastty</span>
                    <span class="tear-tab tear-tab-active tear-tab-torn">~/projects/fastty</span>
                  </div>
                  <div class="tear-body">
                    <div class="tear-line"><span class="ws">❯</span> cargo build</div>
                    <div class="tear-line"><span class="ws">❯</span></div>
                  </div>
                </div>

                <div class="tear-window tear-window-2">
                  <div class="tear-tabs">
                    <span class="tear-tab tear-tab-active">~/projects/fastty</span>
                  </div>
                  <div class="tear-body">
                    <div class="tear-line"><span class="ws">❯</span> cargo build</div>
                    <div class="tear-line"><span class="ws">❯</span></div>
                  </div>
                </div>

                <div class="tear-ghost">
                  <span class="tear-tab tear-tab-active tear-tab-dragging">~/projects/fastty</span>
                </div>
              </div>
              <p class="tear-caption mono">
                shared atlas via <span>Arc</span> · spawn: <span>0.8 ms</span>
              </p>
            )}

            {f.visual === "bottombar" && (
              <div class="visual-bottombar">
                <div class="vb-scrollback mono">
                  <div class="vb-line"><span class="ws">❯</span> kubectl get pods -n prod</div>
                  <div class="vb-line vb-dim">NAME                  READY   STATUS    RESTARTS   AGE</div>
                  <div class="vb-line vb-dim">api-7d4b9c-xjp2       1/1     Running   0          14m</div>
                  <div class="vb-line vb-dim">api-7d4b9c-kw7r       1/1     Running   0          14m</div>
                  <div class="vb-line vb-dim">worker-9f3a-mn1       2/2     Running   1          3h</div>
                </div>
                <div class="vb-bottombar mono">
                  <span class="vb-seg vb-git"><span class="vb-icon">⎇</span> main <span class="vb-meta">↑2 <span class="vb-dirty">●3</span></span></span>
                  <span class="vb-seg vb-time">14:32:08</span>
                  <span class="vb-spacer"></span>
                  <span class="vb-seg vb-click">kube: <b>prod</b> <span class="vb-hint">click → cycle</span></span>
                  <span class="vb-seg">aws: <b>dev</b></span>
                </div>
                <div class="vb-caption mono">
                  widgets.toml → poll interval · click action · align
                </div>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="features-secondary" data-reveal>
      <div class="secondary-row">
        <div class="secondary-text">
          <span class="feature-num mono">[+]</span>
          <h3 class="feature-title secondary-title">Snippets, TUI-safe.</h3>
          <p class="feature-body">
            Type <span class="inline-mono">gst</span>, press Tab, get <span class="inline-mono">git status</span>.
            Bundled defaults cover git, docker, rust, filesystem, search, system.
            VSCode-style placeholders, live reload. TUI apps take precedence
            and Tab passes through to vim, fzf, htop.
          </p>
        </div>
        <pre class="code-block code-snippets"><code><span class="c-cmt"># snippets.toml</span>
<span class="c-kw">[</span><span class="c-fn">snippet</span><span class="c-kw">]</span>

<span class="c-str">"gst"</span> = <span class="c-str">"git status"</span>
<span class="c-str">"gcm"</span> = <span class="c-str">"git commit -m \&#34;<span class="c-pp">$&#123;1:message&#125;</span>\&#34;"</span>
<span class="c-str">"cb"</span>  = <span class="c-str">"cargo build"</span>
<span class="c-str">"dps"</span> = <span class="c-str">"docker ps"</span>
<span class="c-str">"ll"</span>  = <span class="c-str">"ls -lah"</span>
<span class="c-str">"ports"</span> = <span class="c-str">"ss -tlnp"</span></code></pre>
      </div>
    </div>
  </div>
</section>

<style>
  .features {
    border-top: 1px solid var(--voltage-line);
    padding-block: 96px 72px;
  }

  @media (min-width: 901px) {
    .features {
      padding-block: 112px;
    }
  }

  .features-intro {
    display: grid;
    grid-template-columns: 80px 1fr;
    column-gap: 32px;
    row-gap: 20px;
    align-items: baseline;
    max-width: 920px;
    margin-bottom: 80px;
  }

  .features-intro .section-num {
    grid-column: 1;
    grid-row: 1;
    font-size: 11px;
    color: var(--voltage-text-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    align-self: start;
    padding-top: 12px;
  }

  .features-title {
    grid-column: 2;
    grid-row: 1;
    font-family: var(--font-sans);
    font-size: 40px;
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-on-surface);
  }

  .features-lead {
    grid-column: 2;
    grid-row: 2;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--voltage-text-muted);
    max-width: 60ch;
  }

  .inline-mono {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-on-surface);
    background: var(--voltage-overlay);
    border: 1px solid var(--voltage-line);
    border-radius: var(--radius-sm);
    padding: 0 6px;
  }

  .features-list {
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  .feature-row {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 72px;
    align-items: start;
  }

  .feature-row[data-side="right"] .feature-text {
    order: 2;
  }

  .feature-row[data-side="right"] .feature-visual {
    order: 1;
  }

  .feature-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 8px;
  }

  .feature-num {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--voltage-text-muted);
    text-transform: uppercase;
  }

  .feature-title {
    font-family: var(--font-sans);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-on-surface);
  }

  .feature-body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--voltage-text-muted);
    max-width: 50ch;
  }

  .feature-visual {
    min-width: 0;
  }

  .code-block {
    background: var(--voltage-deep);
    border: 1px solid var(--voltage-line);
    border-radius: 6px;
    padding: 18px 20px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--color-on-surface);
    overflow-x: auto;
    margin: 0;
  }

  .code-block code {
    font-family: inherit;
    color: inherit;
    background: none;
    padding: 0;
  }

  .c-kw  { color: #b294bb; }
  .c-fn  { color: #82a8d8; }
  .c-type { color: #f0c674; }
  .c-str { color: #b5bd68; }
  .c-num { color: #f0c674; }
  .c-cmt { color: var(--voltage-text-subtle); font-style: italic; }
  .c-attr { color: #cc6666; }
  .c-pipe { color: var(--voltage-text-muted); }
  .c-accent { color: var(--voltage-orange); font-weight: 600; }

  .visual-cell {
    border: 1px solid var(--voltage-line);
    border-radius: 6px;
    overflow: hidden;
    background: var(--voltage-deep);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.02) inset,
      0 24px 60px -32px rgba(0, 0, 0, 0.6);
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(0.85); }
  }

  .vc-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: #0a0907;
    border-bottom: 1px solid var(--voltage-line);
  }

  .vc-dots {
    display: inline-flex;
    gap: 4px;
  }

  .vc-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
  }

  .vc-tab {
    flex: 1;
    font-size: 11px;
    color: var(--voltage-text-muted);
  }

  .vc-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--voltage-orange);
    padding: 2px 8px;
    background: rgba(255, 157, 0, 0.08);
    border: 1px solid rgba(255, 157, 0, 0.22);
    border-radius: var(--radius-sm);
  }

  .vc-screen {
    padding: 24px 24px 22px;
    font-size: 13px;
    line-height: 1.95;
    color: var(--color-on-surface);
    min-height: 178px;
  }

  .vc-line {
    display: flex;
    align-items: baseline;
  }

  .vc-sigil {
    color: var(--voltage-orange);
    font-weight: 600;
    margin-right: 12px;
  }

  .vc-out {
    margin: 4px 0;
    color: var(--voltage-text-muted);
    letter-spacing: 0.02em;
  }

  .vc-out-dir { color: #b294bb; font-weight: 600; }
  .vc-out-dim { color: var(--voltage-text-subtle); }
  .vc-out-file { color: #82a8d8; }
  .vc-out-exec { color: #6ec77a; font-weight: 600; }

  .vc-glyphs {
    letter-spacing: 0.06em;
    font-size: 12.5px;
  }

  .vc-active {
    margin-top: 6px;
  }

  .vc-cursor {
    display: inline-block;
    width: 7px;
    height: 14px;
    background: var(--voltage-orange);
    border-radius: 1px;
    animation: blink 1.05s steps(2) infinite;
    margin-left: 2px;
    vertical-align: text-bottom;
  }

  .vc-foot {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    background: #070504;
    border-top: 1px solid var(--voltage-line);
    font-size: 10.5px;
    color: var(--voltage-text-muted);
  }

  .vc-foot-label {
    color: var(--voltage-orange);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .vc-foot-backends {
    letter-spacing: 0.02em;
  }

  .visual-idle {
    border: 1px solid var(--voltage-line);
    border-radius: 6px;
    overflow: hidden;
    background: var(--voltage-deep);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.02) inset,
      0 24px 60px -32px rgba(0, 0, 0, 0.6);
  }

  .vi-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: #0a0907;
    border-bottom: 1px solid var(--voltage-line);
  }

  .vi-dots {
    display: inline-flex;
    gap: 4px;
  }

  .vi-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
  }

  .vi-tab {
    flex: 1;
    font-size: 11px;
    color: var(--voltage-text-muted);
  }

  .vi-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #6ec77a;
    padding: 2px 8px;
    background: rgba(110, 199, 122, 0.08);
    border: 1px solid rgba(110, 199, 122, 0.22);
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .vi-tag::before {
    content: "";
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #6ec77a;
    box-shadow: 0 0 6px rgba(110, 199, 122, 0.6);
    animation: pulse-dot 1.8s var(--ease-out) infinite;
  }

  .vi-screen {
    padding: 24px 24px 22px;
    font-size: 13px;
    line-height: 1.95;
    color: var(--color-on-surface);
    min-height: 152px;
  }

  .vi-line {
    display: flex;
    align-items: baseline;
  }

  .vi-sigil {
    color: var(--voltage-orange);
    font-weight: 600;
    margin-right: 12px;
  }

  .vi-out {
    margin: 4px 0;
  }

  .vi-dim {
    color: var(--voltage-text-muted);
  }

  .vi-blank {
    height: 8px;
  }

  .vi-cursor {
    display: inline-block;
    width: 7px;
    height: 14px;
    background: var(--voltage-orange);
    border-radius: 1px;
    animation: blink 1.05s steps(2) infinite;
    margin-left: 2px;
    vertical-align: text-bottom;
  }

  .vi-foot {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 18px;
    padding: 14px 16px;
    background: #070504;
    border-top: 1px solid var(--voltage-line);
  }

  .vi-stat {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
    font-size: 11px;
  }

  .vi-stat-key {
    color: var(--voltage-text-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 10px;
    min-width: 52px;
  }

  .vi-stat-bar {
    height: 4px;
    background: rgba(255, 255, 255, 0.06);
    border-radius: 2px;
    overflow: hidden;
    display: block;
  }

  .vi-stat-bar i {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--voltage-orange), var(--voltage-yellow));
    border-radius: 2px;
    transition: width 900ms var(--ease-out);
  }

  .feature-row.is-revealed .vi-stat-bar i {
    width: var(--w, 0);
  }

  .feature-row.is-revealed .vi-stat:nth-child(2) .vi-stat-bar i { transition-delay: 100ms; }
  .feature-row.is-revealed .vi-stat:nth-child(3) .vi-stat-bar i { transition-delay: 200ms; }
  .feature-row.is-revealed .vi-stat:nth-child(4) .vi-stat-bar i { transition-delay: 300ms; }

  .vi-stat-val {
    color: var(--color-on-surface);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    min-width: 52px;
    text-align: right;
  }

  .visual-tabs {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .win {
    background: var(--voltage-deep);
    border: 1px solid var(--voltage-line);
    border-radius: 6px;
    overflow: hidden;
  }

  .win-bar {
    padding: 6px 12px;
    background: #0a0907;
    border-bottom: 1px solid var(--voltage-line);
    font-size: 11px;
    color: var(--voltage-text-muted);
  }

  .win-body {
    padding: 14px 16px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.8;
    color: var(--color-on-surface);
  }

  .win-line {
    color: var(--voltage-text-muted);
  }

  .win-2 {
    opacity: 0.7;
  }

  .ws {
    color: var(--voltage-orange);
  }

  .tab-arrow {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    padding-right: 32px;
    color: var(--voltage-orange);
  }

  .visual-tabs-caption {
    font-size: 11px;
    color: var(--voltage-text-muted);
    text-align: right;
    padding-top: 4px;
  }

  .visual-tabs-caption span {
    color: var(--color-on-surface);
  }

  .tear-stage {
    position: relative;
    height: 168px;
    margin-bottom: 10px;
  }

  .tear-window {
    position: absolute;
    top: 12px;
    left: 12px;
    width: 56%;
    background: var(--voltage-deep);
    border: 1px solid var(--voltage-line);
    border-radius: 6px;
    overflow: hidden;
  }

  .tear-window-1 {
    z-index: 2;
  }

  .tear-window-2 {
    z-index: 1;
    opacity: 0;
    transform: translate(0, 0) scale(0.96);
    animation: tear-spawn 7s var(--ease-out) infinite;
    transform-origin: 0 50%;
  }

  .tear-tabs {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    background: #0a0907;
    border-bottom: 1px solid var(--voltage-line);
  }

  .tear-tab {
    display: inline-flex;
    align-items: center;

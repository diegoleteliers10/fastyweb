---
import { fetchRepo, stripVersionPrefix } from "../../lib/repo";

const { version } = await fetchRepo();
const numericVersion = stripVersionPrefix(version);

const features = [
  {
    title: "Low-level Paint API & Pixel-Perfect Grid",
    body: "Direct GPU hardware quad rendering with per-cell advance control. Box-drawing characters and block elements are synthesized at exact pixel boundaries with zero hairline gaps for seamless TUI banners and logos.",
    visual: "wgsl",
  },
  {
    title: "Sub-1% CPU at idle & Synchronized Output",
    body: "The event loop rests when inactive. DEC mode 2026 synchronized output guarantees zero tearing or flicker during intensive CLI and TUI rendering.",
    visual: "idle",
  },
  {
    title: "Split Panes, Tab Tear-Out & AI Agent Control",
    body: "Split any tab horizontally or vertically (⌘D / ⌘⇧D). Drag tabs to tear out standalone windows. Launch targeted sessions from scripts and AI agents via CLI options.",
    visual: "tabs",
  },
  {
    title: "Widgets, Prompt Jumps & Token Detection",
    body: "Live status bar with Git, Kubernetes, AWS, and custom command widgets. Jump between prompts (⌘⇧↑ / ⌘⇧↓), and click auto-detected URLs, file paths, and hex colors.",
    visual: "bottombar",
  },
];
---

<section class="section features" id="features">
  <div class="container">
    <header class="features-intro">
      <h2 class="features-title">
        Four primitives, one<br />
        quiet terminal.
      </h2>
      <p class="features-lead" data-reveal data-reveal-index="2">
        Fastty is built for uncompromising speed, low memory footprint, and deep extensibility.
        From local IPC session multiplexing and embedded WebAssembly gateways to pixel-perfect GPUI rendering.
      </p>
    </header>

    <div class="features-list">
      {features.map((f, i) => (
        <article class="feature-row" data-side={i % 2 === 0 ? "left" : "right"} data-reveal>
          <div class="feature-text">
            <h3 class="feature-title">{f.title}</h3>
            <p class="feature-body">{f.body}</p>
          </div>

          <div class="feature-visual">
            {f.visual === "wgsl" && (
              <div class="visual-cell">
                <div class="vc-bar mono">
                  <div class="vc-dots" aria-hidden="true"><span></span><span></span><span></span></div>
                  <span class="vc-tab">~/projects/fastty</span>
                  <span class="vc-tag">paint api renderer</span>
                </div>
                <div class="vc-screen mono" data-terminal>
                  <div class="vc-line" data-line="1">
                    <span class="vc-sigil">❯</span>
                    <span class="vc-cmd" data-typed="ls --color=always">ls --color=always</span>
                    <span class="vc-cursor" data-cursor="1" aria-hidden="true"></span>
                  </div>
                  <div class="vc-output" data-output="1">
                    <div class="vc-out">
                      <span class="vc-out-dir">.</span>
                      <span class="vc-out-dim">..</span>
                      <span class="vc-out-file">README.md</span>
                      <span class="vc-out-file">Cargo.toml</span>
                      <span class="vc-out-exec">target/</span>
                    </div>
                    <div class="vc-out vc-glyphs">─ │ ┌ ┐ └ ┘ ├ ┤ ┬ ┴ ┼ ░ ▒ ▓ █</div>
                    <div class="vc-out vc-glyphs">← → ↑ ↓ ⇄ ★ ◆ ⚡ ✓ ✗ · α β γ δ · 你好</div>
                  </div>
                  <div class="vc-line vc-active" data-line="2">
                    <span class="vc-sigil">❯</span>
                    <span class="vc-cursor" data-cursor="2" aria-hidden="true"></span>
                  </div>
                </div>
                <div class="vc-foot mono">
                  <span class="vc-foot-label">gpui</span>
                  <span class="vc-foot-backends">metal · vulkan · directx · wayland · x11</span>
                </div>
              </div>
            )}

            {f.visual === "idle" && (
              <div class="visual-idle">
                <div class="vi-bar mono">
                  <div class="vi-dots" aria-hidden="true"><span></span><span></span><span></span></div>
                  <span class="vi-tab">~/projects/fastty</span>
                  <span class="vi-tag">idle · 02:14:08</span>
                </div>
                <div class="vi-screen mono" data-terminal>
                  <div class="vi-line" data-line="1">
                    <span class="vi-sigil">❯</span>
                    <span class="vi-cmd" data-typed="cargo build --release">cargo build --release</span>
                    <span class="vi-cursor" data-cursor="1" aria-hidden="true"></span>
                  </div>
                  <div class="vi-output" data-output="1">
                    <div class="vi-out vi-dim">    Compiling fastty {numericVersion} (38 crates)</div>
                    <div class="vi-out vi-dim">    Finished `release` in 4.21s</div>
                  </div>
                  <div class="vi-line vi-active" data-line="2">
                    <span class="vi-sigil">❯</span>
                    <span class="vi-cursor" data-cursor="2" aria-hidden="true"></span>
                  </div>
                </div>
                <div class="vi-foot mono">
                  <div class="vi-stat">
                    <span class="vi-stat-key">cpu</span>
                    <span class="vi-stat-bar"><i style="--scale: 0.01"></i></span>
                    <span class="vi-stat-val">0.7%</span>
                  </div>
                  <div class="vi-stat">
                    <span class="vi-stat-key">rss</span>
                    <span class="vi-stat-bar"><i style="--scale: 0.18"></i></span>
                    <span class="vi-stat-val">52 mb</span>
                  </div>
                  <div class="vi-stat">
                    <span class="vi-stat-key">wakeups</span>
                    <span class="vi-stat-bar"><i style="--scale: 0"></i></span>
                    <span class="vi-stat-val">0.0/s</span>
                  </div>
                  <div class="vi-stat">
                    <span class="vi-stat-key">energy</span>
                    <span class="vi-stat-bar"><i style="--scale: 0.04"></i></span>
                    <span class="vi-stat-val">12 mj</span>
                  </div>
                </div>
              </div>
            )}

            {f.visual === "tabs" && (
              <div class="tear-stage" data-motion-stage aria-hidden="true">
                <div class="tear-window tear-window-1">
                  <div class="tear-tabs">
                    <span class="tear-tab tear-tab-active">~/projects/fastty</span>
                    <span class="tear-tab tear-tab-active tear-tab-torn">~/projects/fastty</span>
                  </div>
                  <div class="tear-body">
                    <div class="tear-line"><span class="ws">❯</span> cargo build</div>
                    <div class="tear-line"><span class="ws">❯</span></div>
                  </div>
                </div>

                <div class="tear-window tear-window-2">
                  <div class="tear-tabs">
                    <span class="tear-tab tear-tab-active">~/projects/fastty</span>
                  </div>
                  <div class="tear-body">
                    <div class="tear-line"><span class="ws">❯</span> cargo build</div>
                    <div class="tear-line"><span class="ws">❯</span></div>
                  </div>
                </div>

                <div class="tear-ghost">
                  <span class="tear-tab tear-tab-active tear-tab-dragging">~/projects/fastty</span>
                </div>
              </div>
              <p class="tear-caption mono">
                multi-window tear-out · CLI automation · spawn: <span>0.8 ms</span>
              </p>
            )}

            {f.visual === "bottombar" && (
              <div class="visual-bottombar">
                <div class="vb-scrollback mono">
                  <div class="vb-line"><span class="ws">❯</span> kubectl get pods -n prod</div>
                  <div class="vb-line vb-dim">NAME                  READY   STATUS    RESTARTS   AGE</div>
                  <div class="vb-line vb-dim">api-7d4b9c-xjp2       1/1     Running   0          14m</div>
                  <div class="vb-line vb-dim">api-7d4b9c-kw7r       1/1     Running   0          14m</div>
                  <div class="vb-line vb-dim">worker-9f3a-mn1       2/2     Running   1          3h</div>
                </div>
                <div class="vb-bottombar mono">
                  <span class="vb-seg vb-git"><span class="vb-icon">⎇</span> main <span class="vb-meta">↑2 <span class="vb-dirty">●3</span></span></span>
                  <span class="vb-seg vb-time">14:32:08</span>
                  <span class="vb-spacer"></span>
                  <span class="vb-seg vb-click">kube: <b>prod</b> <span class="vb-hint">click → cycle</span></span>
                  <span class="vb-seg">aws: <b>dev</b></span>
                </div>
                <div class="vb-caption mono">
                  widgets.toml → poll interval · click action · align
                </div>
              </div>
            )}
          </div>
        </article>
      ))}
    </div>

    <div class="features-secondary" data-reveal>
      <div class="secondary-row">
        <div class="secondary-text">
          <h3 class="feature-title secondary-title">Local Daemon & Web Gateway.</h3>
          <p class="feature-body">
            Fastty runs a built-in Unix domain socket multiplexer (<span class="inline-mono">fasttyd.sock</span>) and an embedded web server (<span class="inline-mono">fastty gateway</span>).
            Attach from terminal (<span class="inline-mono">fastty attach</span>), watch sessions in real time, spawn and drive sessions from scripts (<span class="inline-mono">fastty spawn</span>, <span class="inline-mono">write</span>, <span class="inline-mono">close</span>), or open <span class="inline-mono">http://localhost:8765</span> to stream any terminal tab at 60/120 FPS via pure WebAssembly — scrollback included.
          </p>
        </div>
        <pre class="code-block code-snippets"><code><span class="c-cmt"># Access active sessions from CLI or Web</span>
<span class="c-fn">fastty</span> sessions --watch
<span class="c-fn">fastty</span> attach 1 --read-only

<span class="c-cmt"># Script the daemon: spawn, type, close</span>
id=$(<span class="c-fn">fastty</span> spawn --cwd ~/api)
<span class="c-fn">fastty</span> write $id --enter <span class="c-str">'bun test'</span>
<span class="c-fn">fastty</span> close $id

<span class="c-cmt"># Native Web Gateway with zero dependencies</span>
<span class="c-fn">fastty</span> gateway --port 8765
<span class="c-cmt"># → Open http://localhost:8765 in browser</span></code></pre>
      </div>

      <div class="secondary-row">
        <div class="secondary-text">
          <h3 class="feature-title secondary-title">MCP Agent Server.</h3>
          <p class="feature-body">
            Connect your AI agents to fastty over the Model Context Protocol — Claude Code,
            OpenCode, Codex, Cursor, Zed, Gemini CLI. Agents get seven tools over your real
            terminals: list, spawn, write, read the screen (scrollback included), resize, close,
            and a one-shot <span class="inline-mono">run_command</span> that returns a command's
            actual rendered output. One command registers fastty into any supported agent's config.
          </p>
        </div>
        <pre class="code-block code-snippets"><code><span class="c-cmt"># Register into Claude Code, OpenCode, Codex,</span>
<span class="c-cmt"># Cursor, Zed, Gemini CLI or Claude Desktop</span>
<span class="c-fn">fastty</span> mcp setup opencode
<span class="c-fn">fastty</span> mcp setup claude-code

<span class="c-cmt"># Then your agent drives real terminals:</span>
<span class="c-fn">fastty_run_command</span> <span class="c-str">"cargo build 2>&1 | tail"</span>
<span class="c-fn">fastty_read_screen</span> <span class="c-str">"watch the dev server"</span></code></pre>
      </div>

      <div class="secondary-row">
        <div class="secondary-text">
          <h3 class="feature-title secondary-title">Snippets, TUI-safe.</h3>
          <p class="feature-body">
            Type <span class="inline-mono">gst</span>, press Tab, get <span class="inline-mono">git status</span>.
            Bundled defaults cover git, docker, rust, filesystem, search, system.
            VSCode-style placeholders, live reload. TUI apps take precedence
            and Tab passes through to vim, fzf, htop.
          </p>
        </div>
        <pre class="code-block code-snippets"><code><span class="c-cmt"># snippets.toml</span>
<span class="c-kw">[</span><span class="c-fn">snippet</span><span class="c-kw">]</span>

<span class="c-str">"gst"</span> = <span class="c-str">"git status"</span>
<span class="c-str">"gcm"</span> = <span class="c-str">"git commit -m \&#34;<span class="c-pp">$&#123;1:message&#125;</span>\&#34;"</span>
<span class="c-str">"cb"</span>  = <span class="c-str">"cargo build"</span>
<span class="c-str">"dps"</span> = <span class="c-str">"docker ps"</span>
 <span class="c-str">"ll"</span>  = <span class="c-str">"ls -lah"</span>
 <span class="c-str">"ports"</span> = <span class="c-str">"ss -tlnp"</span></code></pre>
      </div>

      <div class="secondary-row">
        <div class="secondary-text">
          <h3 class="feature-title secondary-title">Insert anything, anywhere.</h3>
          <p class="feature-body">
            One anchored fuzzy picker (<span class="inline-mono">⌃⌘,</span>) inserts paths to
            anything at the prompt: workspace files, SSH hosts from your config, local git
            branches, snippet bodies, even running docker containers. Files land quoted,
            commands pre-filled (<span class="inline-mono">ssh …</span>, <span class="inline-mono">git checkout …</span>),
            snippets expanded. It complements your shell — it never hijacks it.
          </p>
        </div>
        <pre class="code-block code-snippets"><code><span class="c-fn">❯</span> ssh <span class="c-str">▌</span>
<span class="c-cmt">┌─ Insert anything ────────────────────┐</span>
<span class="c-cmt">│</span> 🖥  prod-api     deploy@10.0.0.1      <span class="c-cmt">│</span>
<span class="c-cmt">│</span> 🖥  homelab      root@192.168.1.10    <span class="c-cmt">│</span>
<span class="c-cmt">└───────────────────────────────────────┘</span></code></pre>
      </div>

      <div class="secondary-row">
        <div class="secondary-text">
          <h3 class="feature-title secondary-title">AI Assistant, Multimodal.</h3>
          <p class="feature-body">
            A built-in agent sidebar with streaming responses, collapsible reasoning,
            and a live context ring. Tools (<span class="inline-mono">read</span>, <span class="inline-mono">search</span>, <span class="inline-mono">run</span>, <span class="inline-mono">edit</span>)
            ask permission first and show real diff cards — and after you approve the same
            command family three times, fastty offers to auto-allow it for good. Bring your own key
            (<span class="inline-mono">Anthropic</span>, <span class="inline-mono">OpenAI-compatible</span>, <span class="inline-mono">Ollama</span>),
            paste images and PDFs straight into the chat,
            or ask from any shell with <span class="inline-mono">fastty ask</span>.
          </p>
        </div>
        <pre class="code-block code-snippets"><code><span class="c-cmt"># One-shot question from any terminal</span>
<span class="c-fn">fastty</span> ask <span class="c-str">"why is this build failing?"</span>

<span class="c-cmt"># Approved 'cargo test' 3 times —</span>
<span class="c-cmt"># auto-allow it from now on? [Auto-allow]</span>

<span class="c-cmt"># Sidebar composer: ⌘V pastes images,</span>
<span class="c-cmt"># the clip button attaches images + PDFs</span></code></pre>
      </div>
    </div>
  </div>
</section>

<style>
  .features {
    padding-block: var(--section-space);
  }

  .features-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 720px;
    margin-bottom: 64px;
  }

  .features-title {
    font-family: var(--font-sans);
    font-size: clamp(42px, 4.4vw, 52px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-on-surface);
  }

  .features-lead {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--voltage-text-muted);
    max-width: 62ch;
  }

  .inline-mono {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-on-surface);
    background: var(--voltage-overlay);
    border: 1px solid var(--voltage-line);
    border-radius: var(--radius-sm);
    padding: 0 6px;
  }

  .features-list {
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  .feature-row {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 72px;
    align-items: start;
  }

  .feature-row[data-side="right"] .feature-text {
    order: 2;
  }

  .feature-row[data-side="right"] .feature-visual {
    order: 1;
  }

  :global(.motion-ready) .feature-row[data-reveal] .feature-text,
  :global(.motion-ready) .feature-row[data-reveal] .feature-visual {
    opacity: 0;
    transform: translateX(-22px);
    transition: opacity 520ms var(--ease-enter), transform 680ms var(--ease-enter);
  }

  :global(.motion-ready) .feature-row[data-reveal] .feature-visual {
    transform: translateX(22px);
    transition-delay: 110ms;
  }

  :global(.motion-ready) .feature-row[data-side="right"][data-reveal] .feature-text {
    transform: translateX(22px);
  }

  :global(.motion-ready) .feature-row[data-side="right"][data-reveal] .feature-visual {
    transform: translateX(-22px);
  }

  :global(.motion-ready) .feature-row[data-reveal].is-revealed .feature-text,
  :global(.motion-ready) .feature-row[data-reveal].is-revealed .feature-visual {
    opacity: 1;
    transform: none;
  }

  .feature-text {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 8px;
  }

  .feature-title {
    font-family: var(--font-sans);
    font-size: 26px;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-on-surface);
  }

  .feature-body {
    font-size: 15px;
    line-height: 1.6;
    color: var(--voltage-text-muted);
    max-width: 50ch;
  }

  .feature-visual {
    min-width: 0;
  }

  .code-block {
    background: var(--voltage-deep);
    border: 1px solid var(--voltage-line);
    border-radius: 6px;
    padding: 18px 20px;
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--color-on-surface);
    overflow-x: auto;
    margin: 0;
  }

  .code-block code {
    font-family: inherit;
    color: inherit;
    background: none;
    padding: 0;
  }

  .c-kw  { color: #b294bb; }
  .c-fn  { color: #82a8d8; }
  .c-type { color: #f0c674; }
  .c-str { color: #b5bd68; }
  .c-num { color: #f0c674; }
  .c-cmt { color: var(--voltage-text-subtle); font-style: italic; }
  .c-attr { color: #cc6666; }
  .c-pipe { color: var(--voltage-text-muted); }
  .c-accent { color: var(--voltage-orange); font-weight: 600; }

  .visual-cell {
    border: 1px solid var(--voltage-line);
    border-radius: 6px;
    overflow: hidden;
    background: var(--voltage-deep);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.02) inset,
      0 24px 60px -32px rgba(0, 0, 0, 0.6);
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.55; transform: scale(0.85); }
  }

  .vc-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: #0a0907;
    border-bottom: 1px solid var(--voltage-line);
  }

  .vc-dots {
    display: inline-flex;
    gap: 4px;
  }

  .vc-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
  }

  .vc-tab {
    flex: 1;
    font-size: 11px;
    color: var(--voltage-text-muted);
  }

  .vc-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--voltage-orange);
    padding: 2px 8px;
    background: rgba(255, 157, 0, 0.08);
    border: 1px solid rgba(255, 157, 0, 0.22);
    border-radius: var(--radius-sm);
  }

  .vc-screen {
    padding: 24px 24px 22px;
    font-size: 13px;
    line-height: 1.95;
    color: var(--color-on-surface);
    min-height: 178px;
  }

  .vc-line {
    display: flex;
    align-items: baseline;
  }

  .vc-sigil {
    color: var(--voltage-orange);
    font-weight: 600;
    margin-right: 12px;
  }

  .vc-out {
    margin: 4px 0;
    color: var(--voltage-text-muted);
    letter-spacing: 0.02em;
  }

  .vc-out-dir { color: #b294bb; font-weight: 600; }
  .vc-out-dim { color: var(--voltage-text-subtle); }
  .vc-out-file { color: #82a8d8; }
  .vc-out-exec { color: #6ec77a; font-weight: 600; }

  .vc-glyphs {
    letter-spacing: 0.06em;
    font-size: 12.5px;
  }

  .vc-output.is-complete .vc-glyphs {
    animation: glyph-resolve 280ms var(--ease-enter) both;
  }

  .vc-output.is-complete .vc-glyphs:last-child {
    animation-delay: 60ms;
  }

  @keyframes glyph-resolve {
    from { opacity: 0.35; }
    to { opacity: 1; }
  }

  .vc-active {
    margin-top: 6px;
  }

  .vc-line:not(.vc-active) .vc-cursor,
  .vi-line:not(.vi-active) .vi-cursor {
    display: none;
  }

  .vc-cursor {
    display: inline-block;
    width: 7px;
    height: 14px;
    background: var(--voltage-orange);
    border-radius: 1px;
    animation: blink 1.05s steps(2) infinite;
    margin-left: 2px;
    vertical-align: text-bottom;
  }

  .vc-foot {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    background: #070504;
    border-top: 1px solid var(--voltage-line);
    font-size: 10.5px;
    color: var(--voltage-text-muted);
  }

  .vc-foot-label {
    color: var(--voltage-orange);
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .vc-foot-backends {
    letter-spacing: 0.02em;
  }

  .visual-idle {
    border: 1px solid var(--voltage-line);
    border-radius: 6px;
    overflow: hidden;
    background: var(--voltage-deep);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.02) inset,
      0 24px 60px -32px rgba(0, 0, 0, 0.6);
  }

  .vi-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: #0a0907;
    border-bottom: 1px solid var(--voltage-line);
  }

  .vi-dots {
    display: inline-flex;
    gap: 4px;
  }

  .vi-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
  }

  .vi-tab {
    flex: 1;
    font-size: 11px;
    color: var(--voltage-text-muted);
  }

  .vi-tag {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;

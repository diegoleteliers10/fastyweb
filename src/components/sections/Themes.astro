const STORAGE_KEY = "fastty-theme";
---

<section class="section themes" id="themes">
  <div class="container">
    <header class="themes-intro">
      <h2 class="themes-title">
        Twenty built-ins,<br />
        light &amp; dark.
      </h2>
      <p class="themes-lead" data-reveal data-reveal-index="2">
        Fastty ships with twenty tuned palettes — six of them light, its
        first — and reads custom JSON themes from
        <span class="inline-mono">~/.config/fastty/themes/</span>. Switch
        live from the command palette or the Settings dropdown, and let
        Automatic Contrast Correction re-tune any color a program requests
        that clashes with the theme. Theme changes re-render every surface:
        scrollback, topbar, tabs, settings, context menu.
      </p>
    </header>

    <div class="themes-split" data-reveal data-reveal-kind="surface">
      <div class="themes-featured">
        <span class="theme-scan" aria-hidden="true"></span>
        <header class="featured-bar">
          <div class="featured-dots" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>
          <span class="featured-name mono" data-theme-label>config.toml · theme = "fastty"</span>
          <span class="featured-tag mono">Live preview</span>
        </header>
        <div class="featured-body mono">
          <div class="featured-line">
            <span class="line-num">1</span>
            <span><span class="tk-kw">use</span> <span class="tk-fn">fastty</span><span>:</span><span class="tk-type">:</span><span class="tk-fn">config</span><span>:</span><span class="tk-type">:</span><span class="tk-fn">Profile</span>;</span>
          </div>
          <div class="featured-line">
            <span class="line-num">2</span>
            <span>&nbsp;</span>
          </div>
          <div class="featured-line">
            <span class="line-num">3</span>
            <span><span class="tk-kw">fn</span> <span class="tk-fn">load_user_themes</span>() -&gt; <span class="tk-type">Vec&lt;Profile&gt;</span> &#123;</span>
          </div>
          <div class="featured-line">
            <span class="line-num">4</span>
            <span>&nbsp;&nbsp;<span class="tk-str">"default"</span>.<span class="tk-fn">into</span>()</span>
          </div>
          <div class="featured-line">
            <span class="line-num">5</span>
            <span>&#125;</span>
          </div>
          <div class="featured-line">
            <span class="line-num">&nbsp;</span>
            <span>&nbsp;</span>
          </div>
          <div class="featured-line">
            <span class="line-num">&gt;</span>
            <span class="tk-prompt">❯</span>
            <span class="cursor" aria-hidden="true"></span>
          </div>
        </div>
      </div>

      <div class="themes-list">
        <header class="list-head mono">
          <span>REGISTRY · 20 bundled + custom</span>
          <span class="list-head-meta">~/.config/fastty/themes/</span>
        </header>
        <ul class="theme-list" role="list">
          {themes.map((t) => (
            <li
              class="theme-item"
              role="button"
              tabindex="0"
              data-theme={t.id}
              data-theme-name={t.name.toLowerCase()}
              aria-pressed="false"
            >
              <div class="theme-swatch" aria-hidden="true">
                <span class="swatch-bg" style={`background:${t.palette.bg};border-color:${t.palette.fg}`}></span>
                <span class="swatch-fg" style={`background:${t.palette.fg}`}></span>
                <span class="swatch-accent" style={`background:${t.palette.accent}`}></span>
              </div>
              <div class="theme-meta">
                <span class="theme-name-row">
                  <span class="theme-name">{t.name}</span>
                  {t.badge && <span class="theme-badge mono">{t.badge}</span>}
                </span>
                <span class="theme-note mono">{t.note}</span>
              </div>
              <span class="theme-file mono">{t.file}</span>
              <span class="theme-active-dot" aria-hidden="true"></span>
            </li>
          ))}
        </ul>
        <p class="themes-footnote mono">
          Custom themes are JSON files. All 18 ANSI fields are optional except
          <span class="inline-mono">background</span> and
          <span class="inline-mono">foreground</span>; missing colors fall
          back to the foreground.
        </p>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ themes, STORAGE_KEY }}>
  const themesMap = {};
  for (const t of themes) themesMap[t.id] = t;

  const applyTheme = (id) => {
    const theme = themesMap[id];
    if (!theme) return;
    const root = document.documentElement;
    const p = theme.palette;
    root.style.setProperty("--theme-bg", p.bg);
    root.style.setProperty("--theme-bg-bar", p.bgBar);
    root.style.setProperty("--theme-fg", p.fg);
    root.style.setProperty("--theme-dim", p.dim);
    root.style.setProperty("--theme-accent", p.accent);
    root.style.setProperty("--theme-prompt", p.prompt);
    root.style.setProperty("--theme-kw", p.kw);
    root.style.setProperty("--theme-fn", p.fn);
    root.style.setProperty("--theme-type", p.type);
    root.style.setProperty("--theme-str", p.str);
    root.style.setProperty("--theme-cmt", p.cmt);

    document.querySelectorAll(".theme-item").forEach((el) => {
      const isActive = el.dataset.theme === id;
      el.dataset.active = isActive ? "true" : undefined;
      el.setAttribute("aria-pressed", isActive ? "true" : "false");
    });

    document.querySelectorAll("[data-theme-label]").forEach((el) => {
      el.textContent = `config.toml · theme = "${theme.id}"`;
    });

    try {
      window.localStorage.setItem(STORAGE_KEY, id);
    } catch {}
  };

  const initial = (() => {
    try {
      const saved = window.localStorage.getItem(STORAGE_KEY);
      if (saved && themesMap[saved]) return saved;
    } catch {}
    return "fastty";
  })();

  applyTheme(initial);

  const featured = document.querySelector(".themes-featured");
  const scan = document.querySelector(".theme-scan");
  let scanAnimation = null;

  document.querySelectorAll(".theme-item").forEach((el) => {
    const handler = () => {
      const id = el.dataset.theme;
      if (!id || el.dataset.active === "true") return;
      applyTheme(id);
      if (!featured || !scan || window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      scanAnimation?.cancel();
      scanAnimation = scan.animate(
        [
          { opacity: 0, transform: "translateX(0)" },
          { opacity: 0.8, offset: 0.18 },
          { opacity: 0, transform: `translateX(${featured.clientWidth}px)` },
        ],
        { duration: 360, easing: "cubic-bezier(0.23, 1, 0.32, 1)" },
      );
    };
    el.addEventListener("click", handler);
    el.addEventListener("keydown", (e) => {
      if (e.key === "Enter" || e.key === " ") {
        e.preventDefault();
        handler();
      }
    });
  });
</script>

<style>
  .themes {
    padding-block: var(--section-space);
  }

  .themes-intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    max-width: 720px;
    margin-bottom: 56px;
  }

  .themes-title {
    font-family: var(--font-sans);
    font-size: clamp(42px, 4.4vw, 52px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.025em;
    color: var(--color-on-surface);
  }

  .themes-lead {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--voltage-text-muted);
    max-width: 62ch;
  }

  .inline-mono {
    font-family: var(--font-mono);
    font-size: 0.9em;
    color: var(--color-on-surface);
    background: var(--voltage-overlay);
    border: 1px solid var(--voltage-line);
    border-radius: var(--radius-sm);
    padding: 0 6px;
  }

  .themes-split {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 48px;
    align-items: start;
  }

  .themes-featured {
    position: relative;
    background: var(--theme-bg, #0C0C0C);
    border: 1px solid var(--voltage-line);
    border-radius: 6px;
    overflow: hidden;
    transition: background 320ms var(--ease-out),
      border-color 320ms var(--ease-out);
  }

  .theme-scan {
    position: absolute;
    z-index: 2;
    inset: 0 auto 0 0;
    width: 1px;
    background: var(--theme-accent, var(--voltage-orange));
    box-shadow: 0 0 16px 3px var(--theme-accent, var(--voltage-orange));
    opacity: 0;
    pointer-events: none;
  }

  .featured-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    background: var(--theme-bg-bar, #0a0907);
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    transition: background 320ms var(--ease-out);
  }

  .featured-dots {
    display: inline-flex;
    gap: 4px;
  }

  .featured-dots span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.18);
  }

  .featured-name {
    font-size: 11px;
    color: var(--theme-fg, #C5C8C6);
    opacity: 0.8;
    flex: 1;
    transition: color 320ms var(--ease-out);
  }

  .featured-tag {
    font-size: 10px;
    color: var(--theme-accent, #b5bd68);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 600;
    transition: color 320ms var(--ease-out);
  }

  .featured-body {
    padding: 22px 24px 24px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 1.85;
    color: var(--theme-fg, #C5C8C6);
    transition: color 320ms var(--ease-out);
  }

  .featured-line {
    display: flex;
    gap: 12px;
  }

  .line-num {
    opacity: 0.3;
    user-select: none;
    min-width: 18px;
    text-align: right;
    flex-shrink: 0;
    color: var(--theme-dim, #5a5754);
  }

  .tk-kw { color: var(--theme-kw, #b294bb); transition: color 320ms var(--ease-out); }
  .tk-fn { color: var(--theme-fn, #81a2be); transition: color 320ms var(--ease-out); }
  .tk-type { color: var(--theme-type, #f0c674); transition: color 320ms var(--ease-out); }
  .tk-str { color: var(--theme-str, #b5bd68); transition: color 320ms var(--ease-out); }
  .tk-prompt { color: var(--theme-prompt, #b5bd68); font-weight: 600; transition: color 320ms var(--ease-out); }

  .cursor {
    display: inline-block;
    width: 7px;
    height: 14px;
    background: var(--theme-accent, #b5bd68);
    border-radius: 1px;
    vertical-align: text-bottom;
    margin-left: 4px;
    animation: blink 1.05s steps(2) infinite;
    transition: background 320ms var(--ease-out);
  }

  .themes-list {
    background: var(--voltage-panel);
    border: 1px solid var(--voltage-line);
    border-radius: 6px;
    overflow: hidden;
  }

  .list-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 10px 16px;
    background: #0a0907;

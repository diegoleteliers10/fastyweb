---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { fetchReleases } from "../data/releases";

const releases = await fetchReleases();
---

<Layout title="Fastty Changelog">
  <Nav />
  <main class="changelog-main">
    <div class="container changelog-container">
      <aside class="changelog-sidebar">
        <nav class="timeline-nav">
          <h4 class="mono">Timeline</h4>
          <ul>
            {releases.map((rel) => (
              <li>
                <a href={`#${rel.tag}`} class="timeline-link mono">
                  <span class="tl-tag">{rel.tag}</span>
                  <span class="tl-date">{rel.date.slice(5)}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>

      <article class="changelog-content">
        <header class="changelog-header">
          <span class="eyebrow mono">[CHANGELOG]</span>
          <h1 class="changelog-title">Version History & Release Notes</h1>
          <p class="changelog-subtitle">
            Chronological log of all additions, improvements, bug fixes, and performance enhancements across Fastty releases.
          </p>
        </header>

        <div class="changelog-feed">
          {releases.map((rel) => (
            <section class="release-entry" id={rel.tag}>
              <div class="release-header-row">
                <div class="release-title-group">
                  <span class="release-tag mono">{rel.tag}</span>
                  {rel.isLatest && <span class="badge-latest mono">LATEST</span>}
                  <span class="release-date mono">{rel.date}</span>
                </div>
                <div class="release-downloads-mini">
                  {rel.downloads.map((d) => (
                    <a href={d.url} class="dl-mini-btn mono" title={`Direct download for ${d.platform} (${d.arch})`} download>
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M12 4v12m0 0l-4-4m4 4l4-4M4 20h16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                      <span>{d.platform === "macOS" ? (d.arch.includes("Apple") ? "macOS ARM" : "macOS Intel") : d.platform}</span>
                    </a>
                  ))}
                </div>
              </div>

              <h2 class="entry-title">{rel.title}</h2>

              {rel.changes.features && rel.changes.features.length > 0 && (
                <div class="change-group">
                  <h3 class="group-label group-feat mono">Features</h3>
                  <ul class="group-list">
                    {rel.changes.features.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              )}

              {rel.changes.fixes && rel.changes.fixes.length > 0 && (
                <div class="change-group">
                  <h3 class="group-label group-fix mono">Fixes & Improvements</h3>
                  <ul class="group-list">
                    {rel.changes.fixes.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              )}

              {rel.changes.performance && rel.changes.performance.length > 0 && (
                <div class="change-group">
                  <h3 class="group-label group-perf mono">Performance</h3>
                  <ul class="group-list">
                    {rel.changes.performance.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              )}

              {rel.changes.chores && rel.changes.chores.length > 0 && (
                <div class="change-group">
                  <h3 class="group-label group-chore mono">Maintenance</h3>
                  <ul class="group-list">
                    {rel.changes.chores.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                </div>
              )}
            </section>
          ))}
        </div>
      </article>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  function setupChangelogScrollSpy() {
    const links = document.querySelectorAll(".timeline-link");
    const sections = Array.from(document.querySelectorAll(".release-entry[id]"));
    if (!links.length || !sections.length) return;

    function updateActive() {
      const scrollY = window.scrollY;
      const offset = 140;
      let currentId = sections[0]?.id;

      for (const section of sections) {
        const el = section as HTMLElement;
        if (scrollY >= el.offsetTop - offset) {
          currentId = el.id;
        }
      }

      links.forEach((link) => {
        const href = link.getAttribute("href");
        if (href === `#${currentId}`) {
          link.setAttribute("data-active", "true");
        } else {
          link.removeAttribute("data-active");
        }
      });
    }

    window.addEventListener("scroll", updateActive, { passive: true });
    updateActive();
  }

  setupChangelogScrollSpy();
  document.addEventListener("astro:page-load", setupChangelogScrollSpy);
</script>

<style>
  .changelog-main {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-4xl);
  }

  .changelog-container {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  .changelog-sidebar {
    position: sticky;
    top: 100px;
    padding-right: var(--space-md);
    max-height: calc(100vh - 120px);
    overflow-y: auto;
  }

  .timeline-nav h4 {
    color: var(--voltage-orange);
    margin-bottom: var(--space-md);
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .timeline-nav ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .timeline-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: var(--voltage-text-muted);
    font-size: 13px;
    text-decoration: none;
    padding: 4px 6px;
    border-radius: var(--radius-sm);
    transition: color 150ms var(--ease-out), background 150ms var(--ease-out);
  }

  .timeline-link:hover,
  .timeline-link[data-active="true"] {
    color: var(--voltage-orange);
    background: rgba(255, 157, 0, 0.08);
  }

  .tl-tag {
    font-weight: 600;
  }

  .tl-date {
    font-size: 11px;
    color: var(--voltage-text-muted);
  }

  .changelog-content {
    max-width: 820px;
  }

  .changelog-header {
    margin-bottom: var(--space-3xl);
  }

  .eyebrow {
    color: var(--voltage-orange);
    font-size: 13px;
    letter-spacing: 0.08em;
    display: inline-block;
    margin-bottom: var(--space-xs);
  }

  .changelog-title {
    font-family: var(--font-sans);
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-sm);
    color: var(--color-on-surface);
  }

  .changelog-subtitle {
    font-size: 17px;
    line-height: 1.6;
    color: var(--voltage-text-subtle);
  }

  .changelog-feed {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
  }

  .release-entry {
    background: var(--voltage-panel);
    border: 1px solid var(--voltage-line);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    scroll-margin-top: 100px;
  }

  .release-header-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    border-bottom: 1px solid var(--voltage-line);
    padding-bottom: var(--space-md);
  }

  .release-title-group {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .release-tag {
    font-size: 22px;
    font-weight: 700;
    color: var(--color-on-surface);
  }

  .badge-latest {
    background: rgba(255, 157, 0, 0.15);
    color: var(--voltage-orange);
    border: 1px solid rgba(255, 157, 0, 0.3);
    font-size: 11px;
    font-weight: 600;
    padding: 2px 7px;
    border-radius: var(--radius-sm);
    letter-spacing: 0.05em;
  }

  .release-date {
    font-size: 13px;
    color: var(--voltage-text-muted);
  }

  .release-downloads-mini {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .dl-mini-btn {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: var(--voltage-text-subtle);
    background: var(--voltage-overlay);
    border: 1px solid var(--voltage-line);
    border-radius: var(--radius-sm);
    padding: 4px 8px;
    text-decoration: none;
    transition: color 150ms var(--ease-out), border-color 150ms var(--ease-out);
  }

  .dl-mini-btn:hover {
    color: var(--voltage-orange);
    border-color: var(--voltage-orange);
  }

  .entry-title {
    font-family: var(--font-sans);
    font-size: 20px;
    font-weight: 600;
    color: var(--color-on-surface);
    margin-bottom: var(--space-lg);
    letter-spacing: -0.01em;
  }

  .change-group {
    margin-bottom: var(--space-md);
  }

  .group-label {
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-bottom: var(--space-xs);
    display: inline-block;
    padding: 2px 6px;
    border-radius: var(--radius-sm);
  }

  .group-feat {
    color: #50fa7b;
    background: rgba(80, 250, 123, 0.1);
  }

  .group-fix {
    color: var(--voltage-orange);
    background: rgba(255, 157, 0, 0.1);
  }

  .group-perf {
    color: #8be9fd;
    background: rgba(139, 233, 253, 0.1);
  }

  .group-chore {
    color: var(--voltage-text-muted);
    background: var(--voltage-overlay);
  }

  .group-list {
    list-style: disc;
    padding-left: var(--space-lg);
    margin: 0;
    color: var(--voltage-text-subtle);
    font-size: 14px;
    line-height: 1.7;
  }

  .group-list li {
    margin-bottom: 4px;
  }

  @media (max-width: 768px) {
    .changelog-container {
      grid-template-columns: 1fr;
    }

    .changelog-sidebar {
      position: static;
      max-height: none;
      border-bottom: 1px solid var(--voltage-line);
      padding-bottom: var(--space-md);
      margin-bottom: var(--space-lg);
    }
  }
</style>

  <Nav />
  <main class="docs-main">
    <div class="container docs-container">
      <aside class="docs-sidebar">
        <nav class="toc">
          <h4 class="mono">Contents</h4>
          <ul>
            <li><a href="#introduction">Architecture</a></li>
            <li><a href="#installation">Installation</a></li>

<script>
  function setupTocScrollSpy() {
    const links = document.querySelectorAll(".toc a");
    const sections = Array.from(document.querySelectorAll(".docs-section[id]"));
    if (!links.length || !sections.length) return;

    function updateActive() {
      const scrollY = window.scrollY;
      const offset = 140;
      let currentSectionId = sections[0]?.id;

      for (const section of sections) {
        const el = section as HTMLElement;
        if (scrollY >= el.offsetTop - offset) {
          currentSectionId = el.id;
        }
      }

      links.forEach((link) => {
        const href = link.getAttribute("href");
        if (href === `#${currentSectionId}`) {
          link.setAttribute("data-active", "true");
        } else {
          link.removeAttribute("data-active");
        }
      });
    }

    window.addEventListener("scroll", updateActive, { passive: true });
    updateActive();
  }

  setupTocScrollSpy();
  document.addEventListener("astro:page-load", setupTocScrollSpy);
</script>

<style>
  .docs-main {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-4xl);
  }
  
  .docs-container {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--space-xl);
    align-items: start;
  }
  
  .docs-sidebar {
    position: sticky;
    top: 100px;
    padding-right: var(--space-lg);
  }

  .toc h4 {
    color: var(--voltage-orange);
    margin-bottom: var(--space-md);
    font-size: 14px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .toc a {
    color: var(--voltage-text-muted);
    font-size: 14px;
    display: inline-block;
    transition: color 150ms var(--ease-out), transform 150ms var(--ease-out);
  }

  .toc a:hover,
  .toc a[data-active="true"] {
    color: var(--voltage-orange);
    font-weight: 500;
  }

  .docs-content {
    max-width: 800px;
    color: var(--color-on-surface);
  }

  .docs-content h1 {
    font-family: var(--font-sans);
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2xl);
  }

  .docs-section {
    margin-bottom: var(--space-3xl);
  }

  .docs-section h2 {
    font-family: var(--font-sans);
    font-size: 24px;
    font-weight: 600;
    margin-bottom: var(--space-md);
    color: var(--color-on-surface);
    letter-spacing: -0.01em;

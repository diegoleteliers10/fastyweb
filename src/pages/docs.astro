                <td><code>Ctrl+Tab</code> / <code>Ctrl+Shift+Tab</code></td>
              </tr>
              <tr>
                <td>Select Tab 1-9</td>
                <td><code>⌘1</code> .. <code>⌘9</code></td>
                <td><code>Alt+1</code> .. <code>Alt+9</code></td>
              </tr>
              <tr>
                <td>Toggle Tab Sidebar</td>
                <td><code>⌘B</code></td>
                <td><code>Ctrl+Shift+B</code></td>
              </tr>
              <tr>
                <td>Command Palette</td>
                <td><code>⌘P</code></td>
                <td><code>Ctrl+Shift+P</code></td>
              </tr>
              <tr>
                <td>SSH Manager</td>
                <td><code>⌘O</code></td>
                <td><code>Ctrl+Shift+O</code></td>
              </tr>
              <tr>
                <td>Project Jumper</td>
                <td><code>⌘J</code></td>
                <td><code>Ctrl+Shift+J</code></td>
              </tr>
              <tr>
                <td>Git Worktrees</td>
                <td><code>⌘⌥W</code></td>
                <td><code>Ctrl+Alt+W</code></td>
              </tr>
              <tr>
                <td>Jump to Prev / Next Prompt</td>
                <td><code>⌘⇧↑</code> / <code>⌘⇧↓</code></td>
                <td><code>Ctrl+Shift+Up</code> / <code>Ctrl+Shift+Down</code></td>
              </tr>
              <tr>
                <td>In-Buffer Search</td>
                <td><code>⌘F</code></td>
                <td><code>Ctrl+F</code></td>
              </tr>
              <tr>
                <td>Settings</td>
                <td><code>⌘,</code> / <code>⌘S</code></td>
                <td><code>Ctrl+,</code> / <code>Ctrl+Shift+S</code></td>
              </tr>
              <tr>
                <td>Reload Config</td>
                <td><code>⌘R</code></td>
                <td><code>Ctrl+Shift+R</code> / <code>F5</code></td>
              </tr>
              <tr>
                <td>Clear Scrollback</td>
                <td><code>⌘K</code></td>
                <td><code>Ctrl+Shift+K</code></td>
              </tr>
              <tr>
                <td>Zoom In / Out / Reset</td>
                <td><code>⌘+</code> / <code>⌘-</code> / <code>⌘0</code></td>
                <td><code>Ctrl++</code> / <code>Ctrl+-</code> / <code>Ctrl+0</code></td>
              </tr>
            </tbody>
          </table>
        </section>

        <section id="benchmarks" class="docs-section">
          <h2>Benchmarks</h2>
          <p>Criterion parser benchmark results on Apple Silicon M-series:</p>
          <ul>
            <li>Plain text parsing: <strong>23.82 µs</strong></li>
            <li>SGR ANSI sequences: <strong>40.87 µs</strong></li>
            <li>Complex mixed output: <strong>23.41 µs</strong></li>
            <li>Idle CPU consumption: <strong>&lt;0.7%</strong></li>
          </ul>
        </section>
      </article>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  function setupTocScrollSpy() {
    const links = document.querySelectorAll(".toc a");
    const sections = Array.from(document.querySelectorAll(".docs-section[id]"));
    if (!links.length || !sections.length) return;

    function updateActive() {
      const scrollY = window.scrollY;
      const offset = 140;
      let currentSectionId = sections[0]?.id;

      for (const section of sections) {
        const el = section as HTMLElement;
        if (scrollY >= el.offsetTop - offset) {
          currentSectionId = el.id;
        }
      }

      links.forEach((link) => {
        const href = link.getAttribute("href");
        if (href === `#${currentSectionId}`) {
          link.setAttribute("data-active", "true");
        } else {
          link.removeAttribute("data-active");
        }
      });
    }

    window.addEventListener("scroll", updateActive, { passive: true });
    updateActive();
  }

  setupTocScrollSpy();
  document.addEventListener("astro:page-load", setupTocScrollSpy);
</script>

<style>
  .docs-main {
    padding-top: var(--space-xl);
    padding-bottom: var(--space-4xl);
  }
  
  .docs-container {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--space-xl);
    align-items: start;
  }
  
  .docs-sidebar {
    position: sticky;
    top: 100px;
    padding-right: var(--space-lg);
  }

  .toc h4 {
    color: var(--voltage-orange);
    margin-bottom: var(--space-md);
    font-size: 14px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .toc a {
    color: var(--voltage-text-muted);
    font-size: 14px;
    display: inline-block;
    transition: color 150ms var(--ease-out), transform 150ms var(--ease-out);
  }

  .toc a:hover,
  .toc a[data-active="true"] {
    color: var(--voltage-orange);
    font-weight: 500;
  }

  .docs-content {
    max-width: 800px;
    color: var(--color-on-surface);
  }

  .docs-content h1 {
    font-family: var(--font-sans);
    font-size: 40px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2xl);
  }

  .docs-section {
    margin-bottom: var(--space-3xl);
  }

  .docs-section h2 {
    font-family: var(--font-sans);
    font-size: 24px;
    font-weight: 600;
    margin-bottom: var(--space-md);
    color: var(--color-on-surface);
    letter-spacing: -0.01em;
  }

  .docs-section h3 {
    font-family: var(--font-sans);
    font-size: 18px;
    font-weight: 600;
    margin-top: var(--space-lg);
    margin-bottom: var(--space-sm);
    color: var(--color-on-surface-variant);
  }

  .docs-section p {
    margin-bottom: var(--space-md);
    line-height: 1.7;
    color: var(--voltage-text-subtle);
  }

  .docs-section ul,
  .docs-section ol {
    margin-bottom: var(--space-md);
    padding-left: var(--space-lg);
    color: var(--voltage-text-subtle);
    line-height: 1.7;
  }

  .docs-section li {
    margin-bottom: var(--space-xs);
  }

  .docs-section strong {
    color: var(--color-on-surface);
  }

  .docs-section code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: var(--voltage-overlay);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--voltage-line);
    color: var(--voltage-orange);
  }

  .code-block {
    background: var(--voltage-panel);
    border: 1px solid var(--voltage-line);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    margin-bottom: var(--space-md);
    overflow-x: auto;
  }

  .code-block pre {
    margin: 0;
  }

  .code-block code {
    background: transparent;
    border: none;
    padding: 0;
    color: var(--color-on-surface);
    font-size: 13px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: var(--space-md);
    background: var(--voltage-panel);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  th, td {
    text-align: left;
    padding: var(--space-sm) var(--space-md);
    border-bottom: 1px solid var(--voltage-line);
  }

  th {
    color: var(--voltage-text-muted);
    font-weight: 600;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: var(--voltage-overlay);
  }

  td {
    color: var(--color-on-surface);
    font-size: 15px;
  }
  
  td code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background: transparent;
    border: 1px solid var(--voltage-line);
    padding: 2px 6px;
    border-radius: var(--radius-sm);
    color: var(--voltage-orange);
  }

  @media (max-width: 768px) {
    .docs-container {
      grid-template-columns: 1fr;
    }
    
    .docs-sidebar {
      position: static;
      margin-bottom: var(--space-xl);
      padding-bottom: var(--space-lg);
      border-bottom: 1px solid var(--voltage-line);
      padding-right: 0;
    }
  }
</style>

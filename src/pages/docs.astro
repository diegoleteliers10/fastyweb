                <td><code>⌘T</code></td>
                <td><code>Ctrl+Shift+T</code></td>
              </tr>
              <tr>
                <td>Close Pane</td>
                <td><code>⌘W</code></td>
                <td><code>Ctrl+Shift+W</code></td>
              </tr>
              <tr>
                <td>Close Tab</td>
                <td><code>⌘⇧W</code></td>
                <td><code>Ctrl+Shift+Q</code></td>
              </tr>
              <tr>
                <td>Split Right</td>
                <td><code>⌘D</code></td>
                <td><code>Ctrl+Shift+E</code></td>
              </tr>
              <tr>
                <td>Split Down</td>
                <td><code>⌘⇧D</code></td>
                <td><code>Ctrl+Shift+D</code></td>
              </tr>
              <tr>
                <td>Navigate Panes</td>
                <td><code>⌘⌥Left / Right / Up / Down</code></td>
                <td><code>Alt+Left / Right / Up / Down</code></td>
              </tr>
              <tr>
                <td>Next / Prev Tab</td>

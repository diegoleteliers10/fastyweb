            <li><a href="#core-features">Core Features</a></li>
            <li><a href="#mission-control">Mission Control (⌘⇧O)</a></li>
            <li><a href="#multi-tab-search">Global Search (⌘⇧F)</a></li>
            <li><a href="#session-persistence">Workspace Persistence</a></li>
            <li><a href="#ssh-manager">SSH Manager & Mux</a></li>
            <li><a href="#split-panes">Split Panes</a></li>
